# Copy to .env and fill in. Never commit .env.
# Generate a key: venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='change-me'
JWT_SECRET_KEY='change-me'  # must be >= 32 random chars: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG='True'
ALLOWED_HOSTS='localhost,127.0.0.1'
DATABASE_URL='postgres://postgres@localhost:5432/mealcycle'
ANTHROPIC_API_KEY='your-anthropic-api-key-here'
# Email (local: Mailtrap → Email Testing → your inbox → SMTP credentials).
# Leave EMAIL_HOST empty to print emails in the terminal instead.
EMAIL_HOST=''
EMAIL_PORT='2525'
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
DEFAULT_FROM_EMAIL='MealCycle <no-reply@mealcycle.local>'
